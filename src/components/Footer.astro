---
import Layout from '../layouts/Layout.astro';
---

<footer class="bg-slate-900 text-white py-16 border-t border-slate-800">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-8 h-8 bg-orange-500 rounded-lg flex items-center justify-center font-bold text-white">S</div>
          <span class="text-xl font-bold tracking-tight">SolarContractor<span class="text-orange-500">Brisbane</span></span>
        </div>
        <p class="text-slate-400 max-w-sm mb-6">
          Providing high-performance, Tier-1 solar solutions for homes across South East Queensland. CEC Accredited and locally owned.
        </p>
        <div class="space-y-2 text-sm text-slate-500">
          <p>Electrical License: QLD 87654</p>
          <p>CEC Accredited Installer: A1234567</p>
          <p>ABN: 12 345 678 910</p>
        </div>
      </div>

      <div>
        <h4 class="font-bold mb-6">Quick Links</h4>
        <ul class="space-y-4 text-slate-400">
          <li><a href="/products/solar-panels" class="hover:text-orange-500 transition-colors">Solar Panels</a></li>
          <li><a href="/products/inverters" class="hover:text-orange-500 transition-colors">Inverters</a></li>
          <li><a href="/rebates/stc-guide" class="hover:text-orange-500 transition-colors">Rebate Guide</a></li>
          <li><a href="/#quote" class="hover:text-orange-500 transition-colors">Free Quote</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-6">Contact</h4>
        <ul class="space-y-4 text-slate-400">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            (07) 1234 5678
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Brisbane, QLD 4000
          </li>
        </ul>
      </div>
    </div>
    
    <div class="pt-8 border-t border-slate-800 text-center text-slate-500 text-sm">
      <p>&copy; {new Date().getFullYear()} Solar Contractor Brisbane. All rights reserved.</p>
    </div>
  </div>
</footer>
