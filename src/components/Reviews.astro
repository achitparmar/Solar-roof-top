---
const reviews = [
  {
    name: "Sarah Jenkins",
    location: "South Yarra",
    text: "Absolutely incredible service. From the initial quote to the final installation, the team was professional and clean. Our first power bill came in $400 cheaper than usual. Highly recommend!",
    rating: 5,
    date: "2 weeks ago"
  },
  {
    name: "Michael Chen",
    location: "Richmond",
    text: "I was skeptical about solar companies after dealing with pushy salesmen. This team was different. Pure engineers. They designed a custom Enphase system that navigated our complex roof shading perfectly.",
    rating: 5,
    date: "1 month ago"
  },
  {
    name: "David & Emma Thompson",
    location: "Kew",
    text: "The 2-hour callback promise is real. The installers were polite, on time, and left the site spotless. The app they set up on our phones makes tracking our savings highly addictive.",
    rating: 5,
    date: "2 months ago"
  }
];
---

<section class="py-24 bg-white overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal opacity-0 translate-y-10">
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6">Don't Take Our Word For It</h2>
      <p class="text-xl text-slate-600">See what your neighbors in Brisbane are saying about their switch to solar.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {reviews.map((review, index) => (
        <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 reveal opacity-0 translate-y-10" style={`transition-delay: ${index * 150}ms;`}>
          <div class="flex items-center gap-1 mb-4">
            {[...Array(review.rating)].map(() => (
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
            ))}
          </div>
          <p class="text-slate-700 italic mb-6 leading-relaxed">"{review.text}"</p>
          <div class="flex items-center justify-between mt-auto">
            <div>
              <div class="font-bold text-slate-900">{review.name}</div>
              <div class="text-sm text-slate-500">{review.location}</div>
            </div>
            <div class="text-xs text-slate-400 bg-slate-200/50 px-3 py-1 rounded-full">{review.date}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center reveal opacity-0 translate-y-10" style="transition-delay: 450ms;">
      <a href="https://google.com" target="_blank" class="inline-flex items-center gap-2 text-slate-600 font-bold hover:text-orange-500 transition-colors">
        Read all 150+ reviews on Google
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
      </a>
    </div>
  </div>
</section>