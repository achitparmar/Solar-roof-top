---
---
<section class="relative min-h-[85vh] flex items-center bg-slate-900 py-20 overflow-hidden">
  <!-- Full-Width Background Image with Gradient Blending -->
  <div class="absolute inset-0 z-0 bg-slate-900">
    <img 
      src="/hero-bg.jpg" 
      onerror="this.src='https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?q=80&w=2072&auto=format&fit=crop'"
      alt="Solar installers working on a residential roof in Brisbane" 
      class="w-full h-full object-cover object-center"
    />
    
    <!-- Mobile: Solid dark wash to ensure text readability -->
    <!-- Desktop: Smooth gradient fading from solid dark on the left to transparent on the right -->
    <div class="absolute inset-0 bg-slate-900/80 lg:bg-transparent lg:bg-gradient-to-r lg:from-slate-900 lg:via-slate-900/90 lg:to-transparent"></div>
  </div>

  <div class="container relative z-10 mx-auto px-4">
    <!-- Restrained width for clean, readable text -->
    <div class="max-w-3xl text-left reveal opacity-0 translate-y-10">
      
      <div class="inline-flex items-center rounded-full bg-orange-500/10 px-4 py-2 text-sm font-bold text-orange-400 ring-1 ring-inset ring-orange-500/30 mb-8 backdrop-blur-sm">
        <span class="flex h-2.5 w-2.5 rounded-full bg-orange-500 mr-3 animate-ping"></span>
        2026 STC Rebates Now Live
      </div>
      
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white mb-6 leading-[1.1]">
        Power Your Home.<br/>
        <span class="text-orange-500">
          Crush Your Bills.
        </span>
      </h1>
      
      <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed max-w-2xl">
        Brisbane's elite solar engineering team. We design high-yield, Tier-1 systems that actually pay for themselves. No gimmicks, just premium installations.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
        <a 
          href="#quote" 
          class="w-full sm:w-auto px-8 py-4 font-bold text-white bg-orange-500 rounded-xl shadow-lg hover:bg-orange-600 transition-colors text-center text-lg"
        >
          Start Free Assessment
        </a>
        
        <div class="flex items-center gap-3 text-slate-300 font-medium">
          <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>2-Hour Callback Promise</span>
        </div>
      </div>

      <!-- Simple Trust Indicators -->
      <div class="mt-12 flex flex-wrap gap-8 pt-8 border-t border-white/10">
        <div class="flex items-center gap-2 text-white">
          <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          <span class="font-bold">4.9/5</span>
          <span class="text-slate-400 text-sm pl-1">Google Reviews</span>
        </div>
        <div class="flex items-center gap-2 text-white">
          <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          <span class="font-bold">10-Year</span>
          <span class="text-slate-400 text-sm pl-1">Workmanship</span>
        </div>
      </div>
    </div>
  </div>
</section>
