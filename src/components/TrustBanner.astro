---
---
<section class="bg-white border-y border-slate-200 py-20 md:py-28 relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">

    <!-- Accreditations Section -->
    <div class="mb-20">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-6">Accredited, Insured & Trusted</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">
          We hold the highest industry certifications to guarantee your system is installed safely and performs flawlessly for decades.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <!-- CEC -->
        <div class="flex flex-col items-center text-center p-10 rounded-[2rem] bg-slate-50 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-24 h-24 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-8 shadow-inner">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">CEC Accredited</h3>
          <p class="text-slate-500 leading-relaxed">Clean Energy Council approved solar retailers and installers, adhering to strict industry guidelines.</p>
        </div>
        
        <!-- Master Electricians -->
        <div class="flex flex-col items-center text-center p-10 rounded-[2rem] bg-slate-50 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-24 h-24 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-8 shadow-inner">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">Master Electricians</h3>
          <p class="text-slate-500 leading-relaxed">Elite electrical contractors delivering the highest standard of safety, workmanship, and ethical conduct.</p>
        </div>
        
        <!-- Liability -->
        <div class="flex flex-col items-center text-center p-10 rounded-[2rem] bg-slate-50 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="w-24 h-24 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center mb-8 shadow-inner">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">$20M Liability Insured</h3>
          <p class="text-slate-500 leading-relaxed">Comprehensive insurance coverage providing you with complete peace of mind during and after installation.</p>
        </div>
      </div>
    </div>

    <div class="w-full h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent mb-20 max-w-4xl mx-auto"></div>

    <!-- Brand Promise Section -->
    <div>
      <div class="text-center mb-16">
        <h2 class="text-2xl md:text-3xl font-black text-slate-900 mb-4">Our Commitment to Excellence</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">
          We stand by our work with industry-leading guarantees, ensuring your investment is protected for decades to come.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-sm text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-4xl font-black text-orange-500 mb-4">25<span class="text-2xl text-slate-400 font-bold">yr</span></div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Performance Warranty</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Guaranteed optimal power generation for 25 years on all installed panels.</p>
        </div>
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-sm text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-4xl font-black text-orange-500 mb-4">10<span class="text-2xl text-slate-400 font-bold">yr</span></div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Workmanship Guarantee</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Comprehensive coverage for all our installation work and roof mounts.</p>
        </div>
        <div class="p-8 bg-white rounded-2xl border border-slate-200 shadow-sm text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="flex justify-center gap-1 mb-4 text-orange-500">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">5-Star Rated Service</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Consistently rated 5 stars by local homeowners for our transparent service.</p>
        </div>
      </div>
    </div>

  </div>
</section>