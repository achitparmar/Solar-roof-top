---
---

<header class="fixed w-full top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200 transition-all duration-300">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-10 h-10 bg-orange-500 rounded-lg flex items-center justify-center text-white font-bold text-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 5a7 7 0 100 14 7 7 0 000-14z"></path></svg>
        </div>
        <span class="text-xl font-black text-slate-900 tracking-tight">Solar<span class="text-orange-500">Brisbane</span></span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-slate-600 hover:text-orange-500 font-medium transition-colors">Home</a>
        <a href="/products/solar-panels" class="text-slate-600 hover:text-orange-500 font-medium transition-colors">Products</a>
        <a href="/rebates/stc-guide" class="text-slate-600 hover:text-orange-500 font-medium transition-colors">Rebates</a>
        <a href="/#contact" class="text-slate-600 hover:text-orange-500 font-medium transition-colors">Contact Us</a>
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center gap-4">
        <a href="tel:+61712345678" class="text-slate-600 font-bold hover:text-orange-500 transition-colors">
          (07) 1234 5678
        </a>
        <a href="/#contact" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-full font-bold transition-colors shadow-lg shadow-orange-500/30">
          Get Free Quote
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button class="md:hidden p-2 text-slate-600" aria-label="Menu" id="mobile-menu-button">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="menu-icon">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden bg-white border-t border-slate-100" id="mobile-menu">
    <div class="container mx-auto px-4 py-4 flex flex-col gap-4">
      <a href="/" class="text-slate-600 hover:text-orange-500 font-medium py-2">Home</a>
      <a href="/products/solar-panels" class="text-slate-600 hover:text-orange-500 font-medium py-2">Products</a>
      <a href="/rebates/stc-guide" class="text-slate-600 hover:text-orange-500 font-medium py-2">Rebates</a>
      <a href="/#contact" class="text-slate-600 hover:text-orange-500 font-medium py-2">Contact Us</a>
      <a href="/#contact" class="bg-orange-500 text-white px-6 py-3 rounded-full font-bold text-center mt-2">
        Get Free Quote
      </a>
    </div>
  </div>
</header>

<!-- Spacer to prevent content from going under fixed header -->
<div class="h-20"></div>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>