---
const projects = [
  {
    image: "https://images.unsplash.com/photo-1508514177221-188b1cf16e9d?q=80&w=2072&auto=format&fit=crop",
    title: "13.2kW Enphase System",
    location: "Paddington",
    savings: "$3,200/yr"
  },
  {
    image: "https://images.unsplash.com/photo-1613665813446-82a78c468a1d?q=80&w=2058&auto=format&fit=crop",
    title: "6.6kW Fronius Installation",
    location: "New Farm",
    savings: "$1,800/yr"
  },
  {
    image: "https://images.unsplash.com/photo-1592833159155-c62df1b65634?q=80&w=2079&auto=format&fit=crop",
    title: "10kW Battery + Solar",
    location: "Ascot",
    savings: "$4,100/yr"
  }
];
---

<section class="py-24 bg-slate-900 overflow-hidden border-y border-slate-800">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6 reveal opacity-0 translate-y-10">
      <div class="max-w-2xl text-white">
        <h2 class="text-4xl md:text-5xl font-black mb-4">Elite Installations</h2>
        <p class="text-xl text-slate-400">Precision engineering on every roof. We treat your property like our own.</p>
      </div>
      <a href="#quote" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl backdrop-blur-sm border border-white/10 transition-all">
        View Full Gallery
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <div class="group relative rounded-3xl overflow-hidden aspect-[4/5] reveal opacity-0 translate-y-10" style={`transition-delay: ${index * 150}ms;`}>
          <!-- Placeholder Image from Unsplash representing solar/roof -->
          <img 
            src={project.image} 
            alt={project.title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          
          <div class="absolute inset-0 p-8 flex flex-col justify-end">
            <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <div class="inline-flex items-center gap-2 px-3 py-1 bg-orange-500/20 text-orange-400 text-sm font-bold rounded-lg mb-3 backdrop-blur-md border border-orange-500/30">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                Saving {project.savings}
              </div>
              <h3 class="text-2xl font-bold text-white mb-1">{project.title}</h3>
              <p class="text-slate-300 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                {project.location}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>