---
const stats = [
  { 
    label: "Systems", 
    value: "2,847+",
    icon: `<svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`
  },
  { 
    label: "Rating", 
    value: "4.9★",
    icon: `<svg class="w-5 h-5 md:w-6 md:h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>`
  },
  { 
    label: "Years", 
    value: "15+",
    icon: `<svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>`
  },
  { 
    label: "Savings", 
    value: "$8.2M",
    icon: `<svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  },
];
---

<section class="relative z-30 px-1 sm:px-4 py-8 md:py-24 bg-slate-50 overflow-hidden">
  <!-- Literal Background Infographics -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Solar Panel (Top Left) -->
    <div class="absolute -left-10 top-10 opacity-5 md:opacity-10 text-slate-400 -rotate-12">
      <svg class="w-48 h-48 md:w-64 md:h-64" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path d="M3.75 6A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 6v12a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18V6z" />
        <path d="M3.75 9h16.5M3.75 12h16.5M3.75 15h16.5M9 3.75v16.5M12 3.75v16.5M15 3.75v16.5" />
      </svg>
    </div>

    <!-- Electricity/Lightning (Bottom Right) -->
    <div class="absolute -right-10 bottom-10 opacity-5 md:opacity-10 text-orange-500 rotate-12">
      <svg class="w-56 h-56 md:w-72 md:h-72" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
        <path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
      </svg>
    </div>
  </div>

  <div class="container mx-auto relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-10 md:mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-black text-slate-900 leading-tight px-4">
        Engineering the <span class="text-orange-500">Change</span> <br class="hidden sm:block"/>
        <span class="text-lg sm:text-xl md:text-2xl font-medium text-slate-500 italic block mt-2">for a cleaner, more affordable Brisbane.</span>
      </h2>
    </div>

    <div class="bg-white/90 backdrop-blur-md rounded-2xl md:rounded-[3rem] shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-white/50 overflow-hidden">
      <div class="grid grid-cols-4 divide-x divide-slate-100">
        {stats.map((stat) => (
          <div class="flex flex-col items-center justify-center text-center gap-1.5 md:gap-4 p-2.5 sm:p-4 md:p-10 hover:bg-orange-50/50 transition-all duration-300 group">
            <div class="text-orange-500 bg-orange-50 p-2 md:p-4 rounded-xl md:rounded-2xl shrink-0 group-hover:scale-110 transition-transform duration-300">
              <Fragment set:html={stat.icon} />
            </div>
            <div>
              <div class="text-lg sm:text-2xl md:text-4xl lg:text-5xl font-black text-slate-900 leading-none mb-0.5 md:mb-2">{stat.value}</div>
              <p class="text-[9px] md:text-xs font-bold text-slate-500 uppercase tracking-tight md:tracking-[0.2em]">{stat.label}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
