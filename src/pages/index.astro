---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBanner from '../components/TrustBanner.astro';
import FrictionlessForm from '../components/interactive/FrictionlessForm';
import SolarCalculator from '../components/interactive/SolarCalculator';
import Reviews from '../components/Reviews.astro';
import Portfolio from '../components/Portfolio.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import Tier1Partners from '../components/Tier1Partners.astro';
---

<Layout title="Solar Contractor Brisbane | Tier-1 Installations & Rebates">
	<main>
		<Hero />
		<TrustBanner />
		
		<section id="contact" class="py-24 bg-white relative overflow-hidden">
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px]"></div>
			<div class="container mx-auto px-4 relative z-10">
				<div class="grid lg:grid-cols-2 gap-16 items-center">
					<div class="reveal opacity-0 translate-y-10">
						<h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 leading-tight">
							Stop Overpaying for Electricity. <br/>
							<span class="text-orange-500">Claim Your Rebate Today.</span>
						</h2>
						<p class="text-xl text-slate-600 mb-8 leading-relaxed">
							The Australian Government is still offering thousands of dollars in STC subsidies for homeowners who switch to solar. We handle all the paperwork, so your discount is applied instantly at the point of sale.
						</p>
						<ul class="space-y-6">
							{[
								"CEC Accredited In-House Engineering Team",
								"Up to $3,200 in Federal STC Rebates",
								"Tier-1 Panels with 25-Year Performance Warranty",
								"10-Year Comprehensive Workmanship Guarantee"
							].map((item, i) => (
								<li class="flex items-center gap-4 text-slate-800 font-bold text-lg reveal opacity-0 translate-y-10" style={`transition-delay: ${i * 100}ms;`}>
									<div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0">
										<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
										</svg>
									</div>
									{item}
								</li>
							))}
						</ul>
					</div>
					
					<div class="reveal opacity-0 translate-y-10" style="transition-delay: 300ms;">
						<FrictionlessForm client:load />
					</div>
				</div>
			</div>
		</section>

		<Tier1Partners />

		<Portfolio />

		<!-- Solar Calculator Section -->
		<section class="py-32 bg-slate-50 relative border-y border-slate-200">
			<div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-orange-500/50 to-transparent"></div>
			<div class="container mx-auto px-4">
				<div class="max-w-3xl mx-auto text-center mb-16 reveal opacity-0 translate-y-10">
					<div class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-orange-600 font-bold text-sm mb-4">Interactive Tool</div>
					<h2 class="text-4xl md:text-5xl font-black text-slate-900 mb-6">Calculate Your Potential Savings</h2>
					<p class="text-xl text-slate-600">
						Use our advanced ROI calculator to see how much you can save by switching to solar in Brisbane. Our estimates include current STC rebates.
					</p>
				</div>
				<div class="reveal opacity-0 translate-y-10" style="transition-delay: 200ms;">
					<SolarCalculator client:visible />
				</div>
			</div>
		</section>

		<Reviews />

		<!-- Resource Hub / Education Section -->
		<section class="py-32 bg-slate-900 text-white relative overflow-hidden">
			<!-- Background effects -->
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-orange-500/10 blur-[120px] rounded-full pointer-events-none"></div>

			<div class="container mx-auto px-4 relative z-10">
				<div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6 reveal opacity-0 translate-y-10">
					<div class="max-w-2xl">
						<h2 class="text-4xl md:text-5xl font-black mb-4">Solar Education Hub</h2>
						<p class="text-xl text-slate-400">We believe an informed customer is our best customer. Explore our guides to make the right choice for your home.</p>
					</div>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					<a href="/products/solar-panels" class="group p-10 rounded-3xl bg-white/5 border border-white/10 hover:border-orange-500/50 hover:bg-white/10 transition-all duration-300 reveal opacity-0 translate-y-10">
						<div class="w-16 h-16 bg-orange-500/20 rounded-2xl flex items-center justify-center text-orange-400 mb-8 group-hover:scale-110 group-hover:bg-orange-500 group-hover:text-white transition-all duration-300">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 5a7 7 0 100 14 7 7 0 000-14z"></path></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4">Solar Panel Guide</h3>
						<p class="text-slate-400 mb-8 leading-relaxed">Learn why Tier-1 hardware matters and how panels perform in Brisbane's heat.</p>
						<span class="text-orange-400 font-bold group-hover:translate-x-2 inline-flex items-center gap-2 transition-transform">
							Read Guide
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
						</span>
					</a>

					<a href="/rebates/stc-guide" class="group p-10 rounded-3xl bg-white/5 border border-white/10 hover:border-green-500/50 hover:bg-white/10 transition-all duration-300 reveal opacity-0 translate-y-10" style="transition-delay: 150ms;">
						<div class="w-16 h-16 bg-green-500/20 rounded-2xl flex items-center justify-center text-green-400 mb-8 group-hover:scale-110 group-hover:bg-green-500 group-hover:text-white transition-all duration-300">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4">Rebate & STC Guide</h3>
						<p class="text-slate-400 mb-8 leading-relaxed">Simple, plain-English breakdown of federal and state incentives available to you.</p>
						<span class="text-green-400 font-bold group-hover:translate-x-2 inline-flex items-center gap-2 transition-transform">
							Read Guide
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
						</span>
					</a>

					<a href="/products/warranty" class="group p-10 rounded-3xl bg-white/5 border border-white/10 hover:border-blue-500/50 hover:bg-white/10 transition-all duration-300 reveal opacity-0 translate-y-10" style="transition-delay: 300ms;">
						<div class="w-16 h-16 bg-blue-500/20 rounded-2xl flex items-center justify-center text-blue-400 mb-8 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
							<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
						</div>
						<h3 class="text-2xl font-bold mb-4">Warranty & Support</h3>
						<p class="text-slate-400 mb-8 leading-relaxed">What happens after installation? Our workmanship and product warranty details.</p>
						<span class="text-blue-400 font-bold group-hover:translate-x-2 inline-flex items-center gap-2 transition-transform">
							Read Guide
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
						</span>
					</a>
				</div>
			</div>
		</section>

		<FAQ />
	</main>
	<Footer />
</Layout>
