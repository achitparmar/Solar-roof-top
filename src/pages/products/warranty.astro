---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Industry Leading Warranties | Solar Contractor Brisbane">
  <main class="py-20">
    <div class="container mx-auto px-4">
      <nav class="mb-8">
        <a href="/" class="text-orange-500 hover:text-orange-600 flex items-center gap-2">
          ← Back to Home
        </a>
      </nav>

      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6">
          Warranties That Actually Mean Something
        </h1>
        <p class="text-xl text-slate-600 mb-12">
          The solar industry is famous for "25-year warranties" from companies that disappear after 2. We do things differently.
        </p>

        <section class="mb-16">
          <h2 class="text-2xl font-bold mb-8">Warranty Comparison Table</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse bg-white rounded-xl shadow-sm overflow-hidden">
              <thead>
                <tr class="bg-slate-900 text-white">
                  <th class="p-4">Component</th>
                  <th class="p-4">Standard Industry</th>
                  <th class="p-4 text-orange-400">Our Premium Standard</th>
                </tr>
              </thead>
              <tbody class="text-slate-600">
                <tr class="border-b border-slate-100">
                  <td class="p-4 font-bold">Solar Panels (Product)</td>
                  <td class="p-4">10 - 12 Years</td>
                  <td class="p-4 font-bold text-slate-900">25 Years</td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-4 font-bold">Inverter</td>
                  <td class="p-4">5 Years</td>
                  <td class="p-4 font-bold text-slate-900">10 Years</td>
                </tr>
                <tr class="border-b border-slate-100">
                  <td class="p-4 font-bold">Workmanship</td>
                  <td class="p-4">1 - 2 Years</td>
                  <td class="p-4 font-bold text-slate-900">10 Years</td>
                </tr>
                <tr>
                  <td class="p-4 font-bold">Mounting Hardware</td>
                  <td class="p-4">5 Years</td>
                  <td class="p-4 font-bold text-slate-900">15 - 25 Years</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="grid md:grid-cols-2 gap-8 mb-16">
          <div class="p-8 rounded-2xl bg-orange-50 border border-orange-100">
            <h3 class="text-xl font-bold mb-4">Post-Installation Support</h3>
            <p class="text-slate-600 mb-4">
              Our relationship doesn't end when the truck leaves your driveway. We provide:
            </p>
            <ul class="space-y-3 text-sm text-slate-700">
              <li class="flex gap-2">✔ System Monitoring App Setup</li>
              <li class="flex gap-2">✔ Annual Performance Checkups</li>
              <li class="flex gap-2">✔ Dedicated Local Support Line</li>
            </ul>
          </div>
          <div class="p-8 rounded-2xl bg-slate-900 text-white">
            <h3 class="text-xl font-bold mb-4 text-orange-400">Who to call?</h3>
            <p class="text-slate-400 mb-6">
              If something breaks, you call us. We handle the manufacturer warranty claim for you. No calling overseas call centers or filling out complex forms.
            </p>
            <div class="text-2xl font-bold text-white">(07) 1234 5678</div>
          </div>
        </section>

        <div class="bg-white p-8 rounded-2xl border border-slate-100 mb-16">
          <h2 class="text-2xl font-bold mb-4">What is "Workmanship" Warranty?</h2>
          <p class="text-slate-600">
            This is the most important warranty you've never heard of. It covers the actual installation—ensuring no roof leaks, proper wiring, and that the system is installed to Australian standards. Most installers give you the bare minimum; we give you a decade of peace of mind.
          </p>
        </div>

        <div class="text-center">
          <a href="/#quote" class="inline-block bg-orange-500 text-white font-bold px-12 py-4 rounded-xl hover:bg-orange-600 transition-all shadow-lg shadow-orange-500/20">
            Start Your Worry-Free Journey
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
