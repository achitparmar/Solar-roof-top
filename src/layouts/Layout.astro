---
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Tier-1 Solar Installations for Brisbane Homes. Claim your Government STC Subsidy. Request a Free Roof Assessment." } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>

		<!-- SEO -->
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://solarwebsite.com.au" />

		<!-- Schema.org for Local Business -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "LocalBusiness",
				"name": "Solar Contractor Brisbane",
				"image": "https://solarwebsite.com.au/logo.png",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "123 Solar Way",
					"addressLocality": "Brisbane",
					"addressRegion": "QLD",
					"postalCode": "4000",
					"addressCountry": "AU"
				},
				"url": "https://solarwebsite.com.au",
				"telephone": "+61712345678"
			}
		</script>
	</head>
	<body class="bg-slate-50 text-slate-900 antialiased selection:bg-orange-500 selection:text-white overflow-x-hidden">
		<Header />
		<slot />
		
		<!-- Sticky WhatsApp Button with Pulse Animation -->
		<a 
			href="https://wa.me/61412345678?text=Hi,%20I'm%20interested%20in%20a%20solar%20assessment" 
			class="fixed bottom-4 right-4 md:bottom-8 md:right-8 z-50 flex items-center justify-center w-16 h-16 bg-[#25D366] rounded-full shadow-[0_0_20px_rgba(37,211,102,0.5)] hover:scale-110 transition-transform duration-300 group"
			aria-label="Chat on WhatsApp"
			target="_blank"
			rel="noopener noreferrer"
		>
			<div class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-75 group-hover:hidden"></div>
			<svg class="w-9 h-9 text-white fill-current relative z-10" viewBox="0 0 24 24">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
			</svg>
		</a>

		<script>
			// Add basic scroll reveal animation logic
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('opacity-100', 'translate-y-0');
						entry.target.classList.remove('opacity-0', 'translate-y-10');
					}
				});
			}, { threshold: 0.1 });

			document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	html { font-family: 'Inter', system-ui, sans-serif; }
	
	.reveal {
		transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
	}
	
	/* Custom animations */
	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-20px); }
	}
	.animate-float {
		animation: float 6s ease-in-out infinite;
	}
	
	@keyframes glow {
		0%, 100% { box-shadow: 0 0 20px rgba(249, 115, 22, 0.2); }
		50% { box-shadow: 0 0 40px rgba(249, 115, 22, 0.6); }
	}
	.animate-glow {
		animation: glow 3s infinite;
	}
</style>
